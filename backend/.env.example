# Database: SQLite works immediately. Replace with PostgreSQL/Supabase when needed.
DATABASE_URL=sqlite:///./helmet_detection.db

# Supplied YOLO model
# best_3class.pt (YOLO11n: bike/helmet/no-helmet) can tie heads to motorbikes, which filters
# pedestrians, signs and cargo. best.pt (YOLOv8n, head classes only, trained at 224px) is the fallback.
MODEL_PATH=./models/best_3class.pt
CONFIDENCE_THRESHOLD=0.25
# General COCO model (YOLO11s) used only to find motorbikes. A head counts as a rider only
# when it sits on a motorbike, which filters out pedestrians. Empty = disabled.
VEHICLE_MODEL_PATH=./models/yolo11s.pt
VEHICLE_MODEL_CLASSES=motorcycle
VEHICLE_CONFIDENCE_THRESHOLD=0.25
VEHICLE_MODEL_TILES=1
IOU_THRESHOLD=0.50
# auto = NVIDIA GPU (CUDA) if available, then Apple GPU (mps), else cpu.
DEVICE=auto
# Inference size. CCTV heads are only ~15-35px, so 640 misses most of them.
# 1280 is the most accurate; 960 is a faster compromise on CPU.
INFERENCE_IMGSZ=1280
# Split each frame into an NxN grid plus the full frame; recovers small, distant riders
# (about 2x more heads detected on CCTV footage) at ~5x the inference cost.
# Use 1 on a slow CPU-only machine.
INFERENCE_TILES=2

# Map class names from the model. Comma-separated and case-insensitive.
HELMET_CLASS_NAMES=with helmet,helmet,wearing helmet
NO_HELMET_CLASS_NAMES=without helmet,no helmet,no_helmet,without_helmet
VEHICLE_CLASS_NAMES=bike,biker,motorcycle,motorbike
# Only count heads sitting on a detected vehicle (ignored when the model has no vehicle class).
REQUIRE_VEHICLE_ASSOCIATION=true
# Areas to ignore, normalized 0..1 as "x1,y1,x2,y2;x1,y1,x2,y2" (e.g. a traffic sign). Empty = none.
IGNORE_ZONES=

# Upload / video processing
MAX_FILE_SIZE_MB=500
ALLOWED_IMAGE_EXTENSIONS=.jpg,.jpeg,.png,.bmp,.webp
ALLOWED_VIDEO_EXTENSIONS=.mp4,.avi,.mov,.mkv,.webm,.m4v

# VIDEO OPTIMIZATION: Adaptive frame stride for performance
# VIDEO_FRAME_STRIDE=1 processes every frame (most accurate, slower)
# VIDEO_FRAME_STRIDE=2-3 skips frames (faster, may miss fast-moving objects)
# Recommendation: 1 for short clips, 2-3 for long videos on CPU
VIDEO_FRAME_STRIDE=1

# Reduce video resolution for faster processing (default: 1280)
# Try 640 on slow machines or 960 for balance
VIDEO_MAX_WIDTH=1280

# TRACKING: Fine-tune centroid tracker
# Max frames to wait before removing track (default: 18)
TRACK_MAX_MISSING=18
# Max distance ratio for matching (default: 0.08 = 8% of frame diagonal)
# Increase to 0.10 for faster-moving objects, decrease to 0.05 for crowded scenes
TRACK_MAX_DISTANCE_RATIO=0.08
# A violation is confirmed when "no helmet" wins the vote over the last N observations
# and appears at least VIOLATION_CONFIRMATION_FRAMES times.
VIOLATION_CONFIRMATION_FRAMES=3
VIOLATION_WINDOW_FRAMES=60
# Minimum share of "no helmet" votes in the window (0.6 = 60%).
VIOLATION_MIN_RATIO=0.6
# Tracks seen fewer times than this are treated as noise and not counted.
TRACK_MIN_HITS=3
# Frames a briefly lost rider keeps its box on the output video.
TRACK_DISPLAY_HOLD=12
# Head-only models: minimum speed (box heights per second) to count as a moving rider.
# Filters out signs and pedestrians on fixed cameras. 0 disables.
TRACK_MIN_SPEED=2.5

# Frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Auth
JWT_SECRET=change-this-secret-for-demo-helmet-app
JWT_EXPIRE_MINUTES=10080
