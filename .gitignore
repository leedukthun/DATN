# Application directories and entry points
/*
!/.gitignore
!/README.md
!/backend/
!/frontend/
!/install_windows.bat
!/run_windows.bat

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
/backend/tests/
/backend/pytest.ini
/backend/requirements-dev.txt

# Local configuration and database
.env
.env.*
!.env.example
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite3

# Files generated during use
/backend/storage/**
!/backend/storage/**/
!/backend/storage/**/.gitkeep

# Frontend dependencies and build output
node_modules/
/frontend/dist/
*.tsbuildinfo
/frontend/vite.config.js
/frontend/vite.config.d.ts

# Temporary files
*.log
.DS_Store
Thumbs.db
