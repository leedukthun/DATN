{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "VS Code: Cài đặt / cập nhật môi trường",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\vscode_setup.ps1"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "focus": false
      }
    },
    {
      "label": "VS Code: Cài đặt lại toàn bộ thư viện",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\vscode_setup.ps1",
        "-Force"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Backend: Kiểm tra model và cấu hình",
      "type": "process",
      "command": "${workspaceFolder}\\backend\\.venv\\Scripts\\python.exe",
      "args": [
        "verify_setup.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}\\backend"
      },
      "dependsOn": "VS Code: Cài đặt / cập nhật môi trường",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Backend: Chạy kiểm thử",
      "type": "process",
      "command": "${workspaceFolder}\\backend\\.venv\\Scripts\\python.exe",
      "args": [
        "-m",
        "pytest",
        "-q"
      ],
      "options": {
        "cwd": "${workspaceFolder}\\backend"
      },
      "dependsOn": "VS Code: Cài đặt / cập nhật môi trường",
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Frontend: Build",
      "type": "process",
      "command": "npm.cmd",
      "args": [
        "run",
        "build"
      ],
      "options": {
        "cwd": "${workspaceFolder}\\frontend"
      },
      "dependsOn": "VS Code: Cài đặt / cập nhật môi trường",
      "problemMatcher": [
        "$tsc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Mở API docs",
      "type": "process",
      "command": "cmd.exe",
      "args": [
        "/c",
        "start",
        "",
        "http://localhost:8000/docs"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "never"
      }
    }
  ]
}
